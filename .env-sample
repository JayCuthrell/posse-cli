# --- Bluesky Configuration ---
# Your Bluesky handle (e.g., jay.bsky.social)
BLUESKY_HANDLE=

# App Password (NOT your main login password!)
# Go to Settings > App Passwords > Add App Password
BLUESKY_APP_PASSWORD=

# --- GoToSocial / Mastodon Configuration ---
# The URL of your instance (e.g., https://gotosocial.example.com)
GOTOSOCIAL_INSTANCE_URL=

# Your Access Token
# You can generate this via your instance's settings or an app generator.
# For GoToSocial, this is often found in Settings > Development > New Application
GOTOSOCIAL_ACCESS_TOKEN=

# --- LinkedIn Configuration ---
# OAuth 2.0 Access Token
# Requires 'w_member_social' scope to post.
# You can get this via the LinkedIn Developer Portal or by running tools/get_token.py
LINKEDIN_ACCESS_TOKEN=

# The URN of the author (person or organization) posting the update.
# Format: urn:li:person:123456789
# You can find this by running tools/get_profile.py after getting your token.
LINKEDIN_AUTHOR=